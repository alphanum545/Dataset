{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifc-workflow-benchmark.org/schemas/calibration-result.schema.json",
  "title": "Deterministic IFC reference-envelope calibration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_instance_id",
    "calibration_version",
    "lower_bounds",
    "reference_schedulers",
    "moheft",
    "anchors",
    "candidate_set_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "base_instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "calibration_version": {"$ref": "common.schema.json#/$defs/identifier"},
    "lower_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t_cp_lb_us", "t_capacity_lb_us", "t_lb_us"],
      "properties": {
        "t_cp_lb_us": {"type": "integer", "minimum": 1},
        "t_capacity_lb_us": {"type": "integer", "minimum": 1},
        "t_lb_us": {"type": "integer", "minimum": 1}
      }
    },
    "reference_schedulers": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/calibrationScheduler"}
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_schedule_id",
        "economical_schedule_id",
        "t_fast_us",
        "t_economical_us",
        "cost_fast_ncu",
        "cost_economical_ncu",
        "deadline_range_degenerate"
      ],
      "properties": {
        "fast_schedule_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "economical_schedule_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "t_fast_us": {"type": "integer", "minimum": 1},
        "t_economical_us": {"type": "integer", "minimum": 1},
        "cost_fast_ncu": {"type": "integer", "minimum": 0},
        "cost_economical_ncu": {"type": "integer", "minimum": 0},
        "deadline_range_degenerate": {"type": "boolean"}
      }
    },
    "moheft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler_id", "scheduler_version", "k", "candidate_schedules"],
      "properties": {
        "scheduler_id": {"const": "deterministic_moheft"},
        "scheduler_version": {"$ref": "common.schema.json#/$defs/identifier"},
        "k": {"const": 50},
        "candidate_schedules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "common.schema.json#/$defs/schedule"}
        }
      }
    },
    "candidate_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "calibrationScheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler_id", "scheduler_version", "schedule"],
      "properties": {
        "scheduler_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "scheduler_version": {"$ref": "common.schema.json#/$defs/identifier"},
        "schedule": {"$ref": "common.schema.json#/$defs/schedule"}
      }
    }
  }
}
