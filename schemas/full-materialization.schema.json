{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifc-workflow-benchmark.org/schemas/full-materialization.schema.json",
  "title": "Complete 2,835-input materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "materialization_version", "dataset_version", "generator_commit_sha", "configuration_sha256", "source_manifest_sha256", "pilot_selection_sha256", "pilot_materialization_sha256", "exposure_manifest_sha256", "base_instance_count", "calibration_count", "instance_count", "cohort_counts", "base_entries", "calibration_entries", "entries", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "materialization_version": {"const": "full_materialization_v1"},
    "dataset_version": {"$ref": "common.schema.json#/$defs/identifier"},
    "generator_commit_sha": {"$ref": "common.schema.json#/$defs/gitSha"},
    "configuration_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "pilot_selection_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "pilot_materialization_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "exposure_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "base_instance_count": {"const": 945},
    "calibration_count": {"const": 945},
    "instance_count": {"const": 2835},
    "cohort_counts": {"$ref": "full-exposure.schema.json#/properties/cohort_counts"},
    "base_entries": {"type": "array", "minItems": 945, "maxItems": 945, "items": {"$ref": "#/$defs/baseEntry"}},
    "calibration_entries": {"type": "array", "minItems": 945, "maxItems": 945, "items": {"$ref": "#/$defs/calibrationEntry"}},
    "entries": {"type": "array", "minItems": 2835, "maxItems": 2835, "items": {"$ref": "#/$defs/instanceEntry"}},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "provenance": {"enum": ["reused_pilot", "generated_full"]},
    "baseEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["base_instance_id", "path", "sha256", "provenance", "generator_commit_sha"],
      "properties": {
        "base_instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^base/[a-z0-9_-]+\\.json$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "generator_commit_sha": {"$ref": "common.schema.json#/$defs/gitSha"}
      }
    },
    "calibrationEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["base_instance_id", "path", "sha256", "candidate_set_sha256", "provenance", "generator_commit_sha"],
      "properties": {
        "base_instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^calibration/[a-z0-9_-]+\\.json$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "candidate_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "generator_commit_sha": {"$ref": "common.schema.json#/$defs/gitSha"}
      }
    },
    "instanceEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["instance_id", "base_instance_id", "path", "sha256", "cohort", "original_split", "family", "target_task_count", "replicate_id", "source_sha256", "resource_scale", "scenario_profile", "qos_profile", "ifc_realization_seed", "provenance", "generator_commit_sha"],
      "properties": {
        "instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "base_instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^instances/(development|holdout|expanded)/[a-z0-9_-]+\\.json$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "cohort": {"enum": ["original_development", "development_sibling", "original_holdout", "holdout_sibling", "expansion_evaluation"]},
        "original_split": {"type": ["string", "null"], "enum": ["development", "holdout", null]},
        "family": {"$ref": "common.schema.json#/$defs/family"},
        "target_task_count": {"enum": [60, 100, 200, 400, 600, 800, 1000]},
        "replicate_id": {"$ref": "common.schema.json#/$defs/replicate"},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "resource_scale": {"$ref": "common.schema.json#/$defs/resourceScale"},
        "scenario_profile": {"$ref": "common.schema.json#/$defs/scenarioProfile"},
        "qos_profile": {"$ref": "common.schema.json#/$defs/qosProfile"},
        "ifc_realization_seed": {"type": "integer", "minimum": 0},
        "provenance": {"$ref": "#/$defs/provenance"},
        "generator_commit_sha": {"$ref": "common.schema.json#/$defs/gitSha"}
      }
    }
  }
}
