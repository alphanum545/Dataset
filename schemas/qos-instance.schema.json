{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifc-workflow-benchmark.org/schemas/qos-instance.schema.json",
  "title": "Materialized joint deadline-budget instance metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "base_instance_id",
    "profile",
    "source_sha256",
    "resource_scale",
    "scenario_profile",
    "ifc_realization_seed",
    "deadline",
    "budget",
    "calibration",
    "joint_feasibility_witness",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "base_instance_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "profile": {"$ref": "common.schema.json#/$defs/qosProfile"},
    "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "resource_scale": {"$ref": "common.schema.json#/$defs/resourceScale"},
    "scenario_profile": {"$ref": "common.schema.json#/$defs/scenarioProfile"},
    "ifc_realization_seed": {"type": "integer", "minimum": 0},
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_schedule_id",
        "economical_schedule_id",
        "t_fast_us",
        "t_economical_us",
        "time_gap_us",
        "interpolation_numerator",
        "interpolation_denominator",
        "deadline_us",
        "deadline_range_degenerate"
      ],
      "properties": {
        "fast_schedule_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "economical_schedule_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "t_fast_us": {"type": "integer", "minimum": 1},
        "t_economical_us": {"type": "integer", "minimum": 1},
        "time_gap_us": {"type": "integer", "minimum": 0},
        "interpolation_numerator": {"type": "integer", "minimum": 0},
        "interpolation_denominator": {"type": "integer", "minimum": 1},
        "deadline_us": {"type": "integer", "minimum": 1},
        "deadline_range_degenerate": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_fast_ncu",
        "cost_floor_ref_ncu",
        "budget_gap_ncu",
        "factor_numerator",
        "factor_denominator",
        "budget_ncu",
        "budget_range_degenerate"
      ],
      "properties": {
        "cost_fast_ncu": {"type": "integer", "minimum": 0},
        "cost_floor_ref_ncu": {"type": "integer", "minimum": 0},
        "budget_gap_ncu": {"type": "integer", "minimum": 0},
        "factor_numerator": {"type": "integer", "minimum": 0},
        "factor_denominator": {"type": "integer", "minimum": 1},
        "budget_ncu": {"type": "integer", "minimum": 0},
        "budget_range_degenerate": {"type": "boolean"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_scheduler_versions",
        "moheft_scheduler_version",
        "moheft_k",
        "candidate_set_sha256"
      ],
      "properties": {
        "reference_scheduler_versions": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "moheft_scheduler_version": {"$ref": "common.schema.json#/$defs/identifier"},
        "moheft_k": {"const": 50},
        "candidate_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "joint_feasibility_witness": {"$ref": "common.schema.json#/$defs/schedule"},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
