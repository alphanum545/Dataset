{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifc-workflow-benchmark.org/schemas/network.schema.json",
  "title": "Routed IFC network",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments", "routes"],
  "properties": {
    "symmetric_routes": {"const": true},
    "bandwidth_unit": {"const": "mbps_decimal"},
    "latency_unit": {"const": "microsecond"},
    "energy_unit": {"const": "picojoule_per_bit"},
    "same_resource_zero_time": {"const": true},
    "same_resource_zero_energy": {"const": true},
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/networkSegment"
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iot_iot_different",
        "iot_fog",
        "iot_cloud",
        "fog_fog_different",
        "fog_cloud",
        "cloud_cloud_different"
      ],
      "properties": {
        "iot_iot_different": {"$ref": "#/$defs/route"},
        "iot_fog": {"$ref": "#/$defs/route"},
        "iot_cloud": {"$ref": "#/$defs/route"},
        "fog_fog_different": {"$ref": "#/$defs/route"},
        "fog_cloud": {"$ref": "#/$defs/route"},
        "cloud_cloud_different": {"$ref": "#/$defs/route"}
      }
    }
  },
  "$defs": {
    "route": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
