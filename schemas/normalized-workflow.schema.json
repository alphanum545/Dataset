{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifc-workflow-benchmark.org/schemas/normalized-workflow.schema.json",
  "title": "Normalized frozen source workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "tasks", "dependencies"],
  "properties": {
    "schema_version": {"const": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "family",
        "target_task_count",
        "actual_task_count",
        "source_replicate",
        "source_sha256",
        "reference_mips"
      ],
      "properties": {
        "workflow_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "family": {"$ref": "common.schema.json#/$defs/family"},
        "target_task_count": {"type": "integer", "minimum": 1},
        "actual_task_count": {"type": "integer", "minimum": 1},
        "source_replicate": {"$ref": "common.schema.json#/$defs/replicate"},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "reference_mips": {"type": "integer", "minimum": 1}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/task"}
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/dependency"}
    }
  }
}
